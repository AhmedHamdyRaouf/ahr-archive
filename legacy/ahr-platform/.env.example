# AHR Platform — environment configuration template.
# Copy to .env.local for local development. Never commit the real .env.local.
#
# This file intentionally has NO real values. Milestone 1 defines the shape
# of configuration only; Supabase project values arrive in Milestone 2
# (Core Data Foundation) once the schema exists.

# --- App ---
NEXT_PUBLIC_APP_ENV=development

# Public base URL used for SEO (sitemap.xml, robots.txt, canonical links).
# Falls back to http://localhost:3000 if unset, but MUST be set to the real
# production domain (e.g. https://ahr.example.com) before deploying, or the
# public sitemap/robots output will still point at localhost.
# Found missing from this file during the Phase 1 Platform Implementation
# audit; the code already reads it (apps/web/lib/page-seo.ts, app/robots.ts,
# app/sitemap.ts) — this is a documentation fix only, no code changed.
NEXT_PUBLIC_SITE_URL=

# --- Supabase (populated starting Milestone 2) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI Integration (14-AI-Integration.md; @ahr/ai) ---
# Server-side only -- never exposed to the client. Required for
# POST /api/ai/suggest to function; every other route works without it.
OPENAI_API_KEY=
# Optional -- defaults to gpt-4o-mini if unset.
OPENAI_MODEL=

# --- Email Provider (packages/notifications) ---
# NOT a fixed variable name: the actual env var holding the email provider's
# API key is named by `platform_settings.email_configuration.apiKeyEnvVar`
# (a database-driven setting, seeded empty — see docs/architecture/09-Integrations.md),
# so there is no single fixed name to declare here. Whichever name is chosen
# there must be set as its own environment variable at deploy time.
